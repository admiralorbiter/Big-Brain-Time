digraph G {

graph [bgcolor="white", pad="0.28", nodesep="0.42", ranksep="0.58", fontname="Arial", fontsize="10", labelloc="t"];
node [shape=box, style="rounded,filled", fillcolor="#F7F8FC", color="#52606D", penwidth="1.1", fontname="Arial", fontsize="10", margin="0.12,0.08"];
edge [color="#66788A", penwidth="1.1", arrowsize="0.72", fontname="Arial", fontsize="9"];

label="Change Propagation and Reviewable Patch Flow";
rankdir=LR;
CH [label="Material change
claim • decision • status • policy"];
DIFF [label="Semantic diff
what meaning changed?"];
DEP [label="Dependency / display / summary graph"];
IMPACT [label="Impact set
stale • conflicting • uncertain"];
PROP [label="Granular proposals
operations + preconditions"];
REV [label="Human review
accept / edit / reject", fillcolor="#F3E8FF"];
EXEC [label="Narrow executor"];
INV [label="Invalidate and rebuild projections"];
AUD [label="Audit + rollback evidence"];
CH -> DIFF -> DEP -> IMPACT -> PROP -> REV -> EXEC -> INV -> AUD;
REV -> IMPACT [label="mark false dependency", style=dashed];
}
digraph G {

graph [bgcolor="white", pad="0.28", nodesep="0.42", ranksep="0.58", fontname="Arial", fontsize="10", labelloc="t"];
node [shape=box, style="rounded,filled", fillcolor="#F7F8FC", color="#52606D", penwidth="1.1", fontname="Arial", fontsize="10", margin="0.12,0.08"];
edge [color="#66788A", penwidth="1.1", arrowsize="0.72", fontname="Arial", fontsize="9"];

label="Continuity and Re-entry Loop";
rankdir=LR;
WORK [label="Active work"];
INT [label="Interruption / stopping point"];
CAP [label="Transition capsule
stop • cue • micro-action • trigger", fillcolor="#FFF4D6"];
CHANGE [label="Time passes
world and project may change"];
PACK [label="Re-entry compiler
current state + changes + conflicts"];
FIRST [label="First productive action", fillcolor="#EAF7EE"];
REF [label="Reflection
was the capsule sufficient?"];
WORK -> INT -> CAP -> CHANGE -> PACK -> FIRST -> WORK;
FIRST -> REF -> CAP [label="improve protocol", style=dashed];
}
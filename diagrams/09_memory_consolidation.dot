digraph G {

graph [bgcolor="white", pad="0.28", nodesep="0.42", ranksep="0.58", fontname="Arial", fontsize="10", labelloc="t"];
node [shape=box, style="rounded,filled", fillcolor="#F7F8FC", color="#52606D", penwidth="1.1", fontname="Arial", fontsize="10", margin="0.12,0.08"];
edge [color="#66788A", penwidth="1.1", arrowsize="0.72", fontname="Arial", fontsize="9"];

label="Conservative Memory Consolidation";
rankdir=LR;
EP [label="Episodes and source artifacts
immutable originals", fillcolor="#FFF4D6"];
CL [label="Candidate clusters
shared topic / entity / task"];
D [label="Exact dedupe and normalization"];
ALT [label="Preserve alternatives
conflicts • perspectives • exceptions"];
ABS [label="Purpose-bound abstraction
summary • pattern • heuristic"];
TEST [label="Retention tests
protected facts • questions • citations"];
SEM [label="Consolidated semantic memory
derived and invalidatable", fillcolor="#EAF7EE"];
EP -> CL -> D -> ALT -> ABS -> TEST -> SEM;
SEM -> EP [label="lineage and drill-down", style=dashed];
TEST -> ABS [label="revise on loss", style=dashed];
}
digraph G {

graph [bgcolor="white", pad="0.28", nodesep="0.42", ranksep="0.58", fontname="Arial", fontsize="10", labelloc="t"];
node [shape=box, style="rounded,filled", fillcolor="#F7F8FC", color="#52606D", penwidth="1.1", fontname="Arial", fontsize="10", margin="0.12,0.08"];
edge [color="#66788A", penwidth="1.1", arrowsize="0.72", fontname="Arial", fontsize="9"];

label="Evidence and Evaluation Flywheel";
rankdir=LR;
BASE [label="Baseline
time • errors • burden • trust"];
CASE [label="Regression cases
known defects • hard questions • attacks"];
BUILD [label="Prototype / change"];
LAB [label="Deterministic and benchmark tests"];
FIELD [label="Real-use pilot"];
INC [label="Incidents, corrections, surprises"];
GATE [label="Maturity gate
prototype → tested → benchmarked → piloted → trusted"];
DEC [label="Keep • simplify • remove • authorize", fillcolor="#EAF7EE"];
BASE -> CASE -> BUILD -> LAB -> FIELD -> INC -> CASE;
LAB -> GATE; FIELD -> GATE; GATE -> DEC; DEC -> BASE;
}
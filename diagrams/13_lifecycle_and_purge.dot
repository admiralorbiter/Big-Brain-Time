digraph G {

graph [bgcolor="white", pad="0.28", nodesep="0.42", ranksep="0.58", fontname="Arial", fontsize="10", labelloc="t"];
node [shape=box, style="rounded,filled", fillcolor="#F7F8FC", color="#52606D", penwidth="1.1", fontname="Arial", fontsize="10", margin="0.12,0.08"];
edge [color="#66788A", penwidth="1.1", arrowsize="0.72", fontname="Arial", fontsize="9"];

label="Memory Lifecycle and Purge Transaction";
rankdir=LR;
REQ [label="Lifecycle request
suppress • archive • retract • redact • purge"];
CLASS [label="Classify purpose, authority, retention, holds"];
ENUM [label="Enumerate representations
canonical • Git • DB • indexes • packs • backups"];
DRY [label="Dry-run impact report"];
APP [label="Explicit approval", fillcolor="#FFF4D6"];
ACT [label="Apply semantic operation"];
REBUILD [label="Invalidate / rebuild derived stores"];
VERIFY [label="Verify active-store outcome"];
RES [label="Payload-free receipt
residual backup disclosure", fillcolor="#EAF7EE"];
REQ -> CLASS -> ENUM -> DRY -> APP -> ACT -> REBUILD -> VERIFY -> RES;
APP -> RES [label="cancel / defer", style=dashed];
}